# Logs
*.log
logs/

# Runtime-generated reports (playbook outputs)
tmp/

# Vite / TypeScript build cache
*.tsbuildinfo
.vite/

# Node modules
node_modules/

# OS
.DS_Store
Thumbs.db

# Quarantined legacy UI folders (moved out of the active source tree)
.legacy-ui/
.legacy-public/

# Frontend build output (regenerated by `npm run build` on Vercel)
dist/

# Local environment overrides
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/

# Vercel deploy metadata (auto-generated)
.vercel/

# ── Secret protection ─────────────────────────────────────────
# Prevent accidental commit of Supabase service-role keys, database
# passwords, and other administrative credentials.
**/supabase-service-role-key*
**/service_role_key*
**/sb_secret_*
**/*.pem
**/*.key
**/secrets.json
**/credentials.json