# MarinaAI Command Hub — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real keys.

# ── Supabase (server-side) ──
# The project URL (https://xxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Service-role key — SERVER-SIDE ONLY. Never expose to browser/Vite.
# Used by server-supabase.js for elevated operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anon key — safe for client-side. Used for RLS-protected reads.
SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (client-side, safe for Vite/Next.js) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Command Hub CTA (web/ only) ──
# The HTTPS URL of the deployed Command Hub.
# Leave unset to use the /hub-access fallback.
# NEXT_PUBLIC_COMMAND_HUB_URL=https://marina-ai-command-hub.vercel.app

# ── LLM Provider ──
# Provider: gemini | ollama | openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
# API key for Gemini/OpenAI (server-side only)
# GEMINI_API_KEY=your-api-key
# OPENAI_API_KEY=your-api-key

# ── Ollama ──
OLLAMA_BASE_URL=http://localhost:11434

# ── Execution Safety ──
# Set to "1" to enable high-risk tool execution (runCommand, installDeps, deploy)
# Requires both this env var AND the permissions.json flag.
MARINA_ENABLE_EXEC=0

# ── Server ──
PORT=3000
NODE_ENV=production