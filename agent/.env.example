# MarinaAI Command Hub — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real keys.

# ── Supabase (BROWSER-SAFE) ──────────────────────────────────
# These two values are safe to expose in client-side code via Vite.
# They are used by src/lib/supabase.ts for browser Auth flows.
VITE_SUPABASE_URL=https://sslgswhhlujryjlrnnfr.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNzbGdzd2hobHVqcnlqbHJubmZyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODczODY1NDQsImV4cCI6MjEwMjk2MjU0NH0.YVuC5N1FylTpYzpSgG_5vxUJfW8QQfkRmJXBI4myji8

# ── Supabase (SERVER-ONLY — NEVER expose to browser/Vite) ────
# Used by server-supabase.js for elevated operations (service-role).
# The service-role key must NEVER appear in client bundles, source
# maps, browser localStorage, network responses, logs, or documents.
SUPABASE_URL=https://sslgswhhlujryjlrnnfr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNzbGdzd2hobHVqcnlqbHJubmZyIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NzM4NjU0NCwiZXhwIjoyMTAyOTYyNTQ0fQ.l5SGRzLa-5gEjB2aitoy-PjawXP8emDRsAGBdHFS0og
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNzbGdzd2hobHVqcnlqbHJubmZyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODczODY1NDQsImV4cCI6MjEwMjk2MjU0NH0.YVuC5N1FylTpYzpSgG_5vxUJfW8QQfkRmJXBI4myji8

# ── Staging Environment Name ──
# Used to guard remote staging operations (e.g. test user creation).
MARINA_ENV=local

# ── Command Hub CTA (web/ only) ──
# The HTTPS URL of the deployed Command Hub.
# Leave unset to use the /hub-access fallback.
# NEXT_PUBLIC_COMMAND_HUB_URL=https://marina-ai-command-hub.vercel.app

# ── LLM Provider ──
# Provider: gemini | ollama | openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
# API key for Gemini/OpenAI (server-side only)
# GEMINI_API_KEY=your-api-key
# OPENAI_API_KEY=your-api-key

# ── Ollama ──
OLLAMA_BASE_URL=http://localhost:11434

# ── Execution Safety ──
# Set to "1" to enable high-risk tool execution (runCommand, installDeps, deploy)
# Requires both this env var AND the permissions.json flag.
MARINA_ENABLE_EXEC=0

# ── Remote Staging Test Guard ──
# Set to "1" to enable remote staging RLS tests. Default is dry-run/report-only.
# NEVER set this in production or committed files.
MARINA_RUN_REMOTE_STAGING_TESTS=0

# ── Wide Research / Web Search ──
# Enable the web-search and research tools (fail-closed until set).
WEB_SEARCH_ENABLED=1
RESEARCH_ENABLED=1
# Search provider key (Tavily recommended). Uncomment and fill when you get a key.
# TAVILY_API_KEY=your-key-here

# ── Code Generation (Phase 4B) ──
# Enable the template-based code-generation tool (fail-closed until set).
CODE_GEN_ENABLED=1

# ── Document Generation ──
# Enable .docx/.xlsx/.pdf deliverable generation (fail-closed until set).
DOC_GEN_ENABLED=1

# ── Knowledge Graph Memory (Phase 4C) ──
# Enable persistent graph memory (remember/recall/reason).
MEMORY_ENABLED=1

# ── Agent Bus (Phase 4E) ──
# Enable cross-agent coordination (registry, message bus, delegation).
AGENT_BUS_ENABLED=1

# ── Image Generation (AI Design) ──
# Enable image generation via a configured provider (fail-closed until key set).
IMAGE_GEN_ENABLED=1
# IMAGE_GEN_PROVIDER=openai
# OPENAI_API_KEY=your-key-here
# STABILITY_API_KEY=your-key-here

# ── Server ──
PORT=3000
NODE_ENV=production