            </div>
            <div class="updates-feed" id="updatesFeed">
              <small class="text-muted">No recent updates.</small>
            </div>
            <button class="ghost-button wide" id="checkUpdatesBtn" style="margin-top: 8px;">
              🔄 Check for Updates
            </button>
          </section>
        </main>`;

// Replace the closing </main> with updates card + closing </main>
htmlContent = htmlContent.replace(
  /\s*<\/main>/,
  updatesCard,
);

fs.writeFileSync(files.html, htmlContent);
console.log("✓ index.html: Command Hub Updates card added at bottom");

