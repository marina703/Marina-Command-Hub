/**
 * Interface Enhancement Patch
 * 1. Removes filler/mockup data from dashboard-state.js
 * 2. Adds Command Hub Updates card at bottom of index.html (playing card size)
 * 3. Adds auto-update capability to dashboard-server.js
 * 4. Adds CSS and JS for the new card
 */
const fs = require("fs");
const path = require("path");

const files = {
  state: path.join(__dirname, "dashboard-state.js"),
  html: path.join(__dirname, "dashboard/public/index.html"),
  css: path.join(__dirname, "dashboard/public/styles.css"),
  js: path.join(__dirname, "dashboard/public/app.js"),
  server: path.join(__dirname, "dashboard-server.js"),
};

// ── 1. Clean up dashboard-state.js: remove filler data, add commandHubUpdates ──
let stateContent = fs.readFileSync(files.state, "utf8");

// Replace the defaultState with clean version (no filler)
const oldStateMatch = stateContent.match(/(const defaultState = \{[\s\S]*?\};\n)/);
if (oldStateMatch) {
  const cleanState = `const defaultState = {
  status: "online",
  mode: "autonomous",
  lastSync: "just now",
  system: {},
  quickStats: [],
  modules: [],
  services: [],
  projects: [
    {
      name: "ignitix.online",
      branch: "production",
      status: "live",
      action: "Monitor & Audit",
    },
    {
      name: "pyroprep.academy",
      branch: "production",
      status: "live",
      action: "Monitor & Audit",
    },
    {
      name: "MarinaAI Agent",
      branch: "main",
      status: "healthy",
      action: "Open in VS Code",
    },
  ],
  projectMilestones: [],
  systemControls: [
    "Clear temp files",
    "Restart services",
    "Optimize system",
    "Toggle high-performance mode",
  ],
  logs: [],
  tasks: [],
  completedHistory: [],
  brainstormIdeas: [],
  meetingAgenda: [],
  aiSummaries: [],
  meetingNotes: [],
  commandHubUpdates: [
    {
      id: "update-1",
      type: "feature",
      title: "Interface cleanup complete",
      description:
        "Removed inline styles, added section descriptions, data-driven sidebar stats, and side-by-side Model Hub + Gemini Sync layout.",
      severity: "info",
      timestamp: new Date().toISOString(),
    },
  ],
};
`;
  stateContent = stateContent.replace(oldStateMatch[1], cleanState);

  // Add commandHubUpdates to migrateState
  if (!stateContent.includes("commandHubUpdates")) {
    stateContent = stateContent.replace(
      /meetingNotes:\s*Array\.isArray\(state\.meetingNotes\)\s*\?\s*state\.meetingNotes\s*:\s*\[\.\.\.defaultState\.meetingNotes\],/,
      `meetingNotes: Array.isArray(state.meetingNotes) ? state.meetingNotes : [...defaultState.meetingNotes],
    commandHubUpdates: Array.isArray(state.commandHubUpdates) ? state.commandHubUpdates : [...defaultState.commandHubUpdates],`,
    );
  }

  fs.writeFileSync(files.state, stateContent);
  console.log("✓ dashboard-state.js: filler data removed, commandHubUpdates added");
} else {
  console.log("⚠ dashboard-state.js: defaultState not found");
}

// ── 2. Add Command Hub Updates card to index.html ──
let htmlContent = fs.readFileSync(files.html, "utf8");

// Add the card right before the closing </main> tag (after Logs panel, before </main>)
const updatesCard = `
          <!-- COMMAND HUB UPDATES: Playing-card sized, bottom of page -->
          <section class="panel command-hub-updates-card" id="commandHubUpdatesCard">
            <div class="panel-header small-header">
              <div>
                <p class="eyebrow">UPDATES</p>
                <h3>Command Hub Updates</h3>
                <small class="panel-desc">
                  Self-installed updates, new tools & widgets auto-added by
                  the Command Hub.
                </small>
              </div>
